{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserStory",
  "type": "object",
  "required": [
    "id",
    "actor",
    "want",
    "benefit",
    "requirementsCovered",
    "acceptanceCriteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^US-[0-9]{3}$"
    },
    "actor": {
      "type": "string"
    },
    "want": {
      "type": "string"
    },
    "benefit": {
      "type": "string"
    },
    "requirementsCovered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "given",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{3}$"
          },
          "given": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "then": {
            "type": "string"
          }
        }
      }
    }
  }
}
