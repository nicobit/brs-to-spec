{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnablementModel",
  "type": "object",
  "properties": {
    "enablementObjectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EO-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "enablementEpics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EPIC-EN-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "enablementFeatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "parentEpic"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FEAT-EN-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "parentEpic": {
            "type": "string"
          },
          "relatedRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "technicalStories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TS-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "requirementsCovered": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
