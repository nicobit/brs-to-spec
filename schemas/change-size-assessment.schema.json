{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeSizeAssessment",
  "type": "object",
  "required": [
    "featureName",
    "classification",
    "recommendedFlow",
    "reasoning"
  ],
  "properties": {
    "featureName": {
      "type": "string"
    },
    "classification": {
      "type": "string",
      "enum": [
        "Small",
        "Medium",
        "Large/Risky"
      ]
    },
    "recommendedFlow": {
      "type": "string",
      "enum": [
        "Minimal",
        "BDD+TestStrategy",
        "FullFramework"
      ]
    },
    "reasoning": {
      "type": "string"
    },
    "riskSignals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredArtifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optionalArtifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
