{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "description",
    "priority"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(FR|NFR|BR|DATA|INT|SEC|AUD|REP)-[0-9]{3}$"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "functional",
        "non-functional",
        "business-rule",
        "data",
        "integration",
        "security",
        "audit",
        "reporting"
      ]
    },
    "description": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Must",
        "Should",
        "Could"
      ]
    },
    "source": {
      "type": "string"
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Reviewed",
        "Approved",
        "Blocked"
      ]
    }
  }
}
