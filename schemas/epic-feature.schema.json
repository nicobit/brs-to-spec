{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EpicFeatureModel",
  "type": "object",
  "properties": {
    "businessObjectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BO-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "successMeasures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "businessObjectives",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EPIC-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "businessObjectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "relatedRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "parentEpic",
          "description",
          "relatedRequirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FEAT-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "parentEpic": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "businessValue": {
            "type": "string"
          },
          "relatedRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidateUserStories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
