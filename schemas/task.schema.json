{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplementationTask",
  "type": "object",
  "required": [
    "id",
    "title",
    "goal",
    "requirementsCovered",
    "definitionOfDone"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3}$"
    },
    "title": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "requirementsCovered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "userStoriesCovered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementationInstructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "doNotDo": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testsRequired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "definitionOfDone": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
