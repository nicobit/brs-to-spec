@startuml
left to right direction
actor Applicant
actor Underwriter
actor ComplianceTeam as "Compliance Team"
actor System as "External Systems"

rectangle "AI-Powered Loan Origination" {
  usecase "UC-001" as UC001
  usecase "UC-002" as UC002
  usecase "UC-003" as UC003
  usecase "UC-004" as UC004
  usecase "UC-005" as UC005
  usecase "UC-006" as UC006
  usecase "UC-007" as UC007
  usecase "UC-008" as UC008
  usecase "UC-009" as UC009
  usecase "UC-010" as UC010
}

Applicant --> UC001
Applicant --> UC004
Applicant --> UC006
Applicant --> UC007
UC001 --> System : Experian, HMRC, AML
UC006 --> System
UC003 --> ComplianceTeam
Underwriter --> UC002
System --> UC005

UC001 : Submit application and receive ARN (FR-001..FR-005)
UC002 : Review referred applications and decide (FR-015..FR-019)
UC003 : Perform AML/KYC screening and flag holds (FR-012..FR-014)
UC004 : Receive and accept loan offer via e-signature (FR-020..FR-023)
UC005 : Trigger disbursement to core banking and confirm (FR-024..FR-027)
UC006 : Trigger AI pre-screening and obtain score (FR-006..FR-009)
UC007 : Notify applicant of auto-decline or send confirmation (FR-004, FR-011)
UC008 : Underwriter queue management and escalations (FR-015, FR-019)
UC009 : Audit logging and observability event emission (FR-028, FR-030)
UC010 : Admin reporting and dashboards (FR-029)

@enduml
