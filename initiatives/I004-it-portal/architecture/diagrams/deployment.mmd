%% Deployment topology (Mermaid)
graph LR
  subgraph Azure
    SWA["Static Web App / CDN"]
    AGW["App Gateway / WAF"]
    APIM["API Gateway"]
    AKS[AKS]
    SQL[(Azure SQL)]
    KV[Key Vault]
    SB[Service Bus]
    Blob[Blob Storage]
    AI[App Insights]
  end

  SWA --> AGW
  AGW --> APIM
  APIM --> AKS
  AKS --> SQL
  AKS --> KV
  AKS --> SB
  AKS --> Blob
  AKS --> AI
  SB --> AKS
  Blob --> AKS
