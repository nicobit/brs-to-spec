%% Component diagram (Mermaid)
graph TD
  subgraph Client
    WebClient["Web Client (SPA)"]
  end

  subgraph Edge
    APIGW["API Gateway / BFF"]
  end

  subgraph Services
    ReqSvc[Request Service]
    IncSvc[Incident Service]
    ChangeSvc[Change Service]
    AssetAdapter[Asset Sync Adapter]
    RunbookSvc[Runbook Service]
    NotifSvc[Notifications Service]
  end

  subgraph Integrations
    SN[ServiceNow]
    GH[GitHub]
    CI[CI/CD]
    Mon[Monitoring]
  end

  subgraph Data
    DB[(Primary DB)]
    Audit[(Audit Store)]
    Blob[(Blob Storage)]
    Search["(Search/Vector Index)"]
    Bus[(Event Bus)]
  end

  WebClient -->|API calls| APIGW
  APIGW --> ReqSvc
  APIGW --> IncSvc
  APIGW --> ChangeSvc
  APIGW --> RunbookSvc
  ReqSvc --> DB
  IncSvc --> DB
  ChangeSvc --> DB
  AssetAdapter -->|reconcile| DB
  AssetAdapter --> SN
  ChangeSvc -->|link| GH
  NotifSvc -->|send| Mon
  ReqSvc --> Bus
  IncSvc --> Bus
  ChangeSvc --> Bus
  Bus --> AssetAdapter
  Bus --> NotifSvc
  DB --> Search
  DB --> Audit
  Blob --> DB
